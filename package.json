{
  "name": "folio-currency-converter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "package": "node scripts/package.mjs",
    "test": "vitest run",
    "check": "biome check . && tsc --noEmit",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "imports": "biome check --write --only=assist/source/organizeImports .",
    "prepare": "husky"
  },
  "dependencies": {
    "@ariakit/react": "0.4.42",
    "framer-motion": "14.9.0",
    "preact": "11.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@preact/preset-vite": "2.10.6",
    "@types/chrome": "^0.1.24",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "happy-dom": "21.0.4",
    "husky": "^9.1.7",
    "terser": "^5.51.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
